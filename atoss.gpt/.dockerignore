# Docker Build Ignore File
# Optimizes Docker image size by excluding unnecessary files

# Dependencies
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log

# Environment Variables
.env
.env.*
!.env.example

# Version Control
.git
.gitignore
.gitattributes

# Documentation
*.md
README.md
CHANGELOG.md
docs/
wiki/

# Development Tools
.vscode/
.idea/
*.swp
*.swo
*~

# Build Artifacts
dist/
build/
.next/
.cache/
out/
coverage/
.nyc_output/

# OS Files
.DS_Store
Thumbs.db
*.tmp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Test Files
__tests__/
*.test.js
*.spec.js
.jest/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Temporary Files
.tmp/
tmp/
temp/

# IDE Caches
.vscode/
.idea/
*.iml

# Knowledge Base (project-specific)
knowledge/

# Yarn/NPM Lock Files (keep in image, but reduce context)
package-lock.json
yarn.lock
pnpm-lock.yaml
