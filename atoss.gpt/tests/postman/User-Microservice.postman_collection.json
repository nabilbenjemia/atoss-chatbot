                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status is 403', function () { pm.response.to.have.status(403); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "List Users (role=Staff)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "{{auth_admin}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/users?role=Staff",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "users"
                    ],
                    "query": [
                        {
                            "key": "role",
                            "value": "Staff"
                        }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                            "var json = pm.response.json();",
                            "pm.test('has users array', function () { pm.expect(json.data && Array.isArray(json.data.users)).to.be.true; });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "Delete User (Admin)",
            "request": {
                "method": "DELETE",
