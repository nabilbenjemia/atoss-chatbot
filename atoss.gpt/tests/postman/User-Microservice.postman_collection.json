                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"{{dupEmail}}\",\n  \"password\": \"Passw0rd!\",\n  \"role\": \"Staff\",\n  \"department\": \"Department 1\",\n  \"firstName\": \"Dup\",\n  \"lastName\": \"Email\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/users",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "users"
