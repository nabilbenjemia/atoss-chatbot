                        "value": "{{auth_admin}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/users/{{userId}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "users",
                        "{{userId}}"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('status is 404', function () { pm.response.to.have.status(404); });"
